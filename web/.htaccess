Options -Indexes

# Revalidate the app and its font manifest together after each update.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|otf|ttf)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  <FilesMatch "\.(html|js|json|otf|ttf)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>
